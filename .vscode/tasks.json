{
    "version": "2.0.0",
    "tasks": [
        {
            // 编译 tmeet 二进制到 workspace 根目录。
            // 供 "MCP server (pipe & run)" task 使用。
            "label": "build-mcp-debug",
            "type": "shell",
            "command": "go",
            "args": ["build", "-o", "${workspaceFolder}/tmeet.exe", "."],
            "group": "build",
            "problemMatcher": ["$go"]
        },
        {
            // ── 非调试快速验证 ──
            // 编译 tmeet.exe 后，把 .vscode/mcp-input.txt 的内容管道喂给 tmeet mcp。
            // 不挂调试器，只看 stdout 输出。改 mcp-input.txt 内容 → Ctrl+Shift+B 重跑。
            // 适合反复验证不同 tool 调用的响应格式。
            "label": "MCP server (pipe & run)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Content -Raw '${workspaceFolder}/.vscode/mcp-input.txt' | & '${workspaceFolder}/tmeet.exe' mcp"
            ],
            "group": "build",
            "problemMatcher": [],
            "dependsOn": "build-mcp-debug"
        }
    ]
}
